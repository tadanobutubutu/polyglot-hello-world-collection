REM * BUBBLE SORT *
DIM ARRAY(10)
INPUT ARRAY(0)
FOR I=1 TO 9
	READ ARRAY(I)
NEXT
FOR K=8 TO 0 STEP -1
	FOR I=0 TO K
		IF ARRAY(I)>ARRAY(I + 1) THEN NEXT I:GOTO OUT
		SWAP = ARRAY(I)
		ARRAY(I) = ARRAY(I + 1)
		ARRAY(I + 1) = SWAP
	NEXT I
	@OUT
	PRINT ARRAY(I)
NEXT K
PRINT ARRAY(0)
END
DATA 1, 2, 3, 5, 9, 8, 7, 4, 6
